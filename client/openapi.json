          "printer_name",
          "job_name",
          "kind",
          "message"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "camera_configured": {
            "type": "boolean"
          },
          "connect_url": {
            "type": "string",
            "format": "uri"
          },
          "can_manage": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "printers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Printer"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            }
          }
        },
        "required": [
          "configured",
          "camera_configured",
          "connect_url",
          "can_manage",
          "printers",
          "history"
        ]
      }
    }

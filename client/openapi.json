{
  "components": {
    "schemas": {
      "Success": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "PrinterSettings": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "camera_id": {
            "type": "string"
          },
          "auto_pause": {
            "type": "boolean"
          },
          "warning_confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "pause_confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "warmup_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1800,
            "default": 180,
            "description": "Minimum automatic warmup delay; extrusion telemetry is also used when available."
          }
        },
        "required": [
          "enabled",
          "camera_id",
          "auto_pause",
          "warning_confidence",
          "pause_confidence",
          "warmup_seconds"
        ],
        "additionalProperties": false
      },
      "Camera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Printer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },

  "info": {
    "title": "OctoEverywhere",
    "version": "0.1.0",
    "description": "Gadget monitoring routes relative to the module mount. The host authenticates requests; printer visibility and management rights are checked for the calling person."
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/modules/com.github.aux.octoeverywhere.connect-extension/printers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "put": {
        "operationId": "save-printer-settings",
        "summary": "Configure monitoring for one printer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrinterSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused or could not be completed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The request was refused or could not be completed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The request was refused or could not be completed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The request was refused or could not be completed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Configure monitoring for one printer. Requests use the host-authorized principal and never accept a caller-supplied principal."
      }
    },

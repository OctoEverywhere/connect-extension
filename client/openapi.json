            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "job_name": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "camera_id": {
            "type": "string"
          },
          "auto_pause": {
            "type": "boolean"
          },
          "warning_confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "pause_confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "warmup_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1800,
            "default": 180,
            "description": "Minimum automatic warmup delay; extrusion telemetry is also used when available."
          },
          "can_manage": {
            "type": "boolean"
          },
          "cameras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Camera"
            }
          },
          "last_inspection_at": {
            "type": "string",
            "format": "date-time"
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "warning": {
            "type": "boolean"
          },
          "pause_suggested": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "state",
          "detail",
          "job_id",
          "job_name",
          "progress",
          "enabled",
          "camera_id",
          "auto_pause",
          "warning_confidence",
          "pause_confidence",
          "warmup_seconds",
          "can_manage",
          "cameras",
          "warning",
          "pause_suggested"
        ]
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "printer_id": {
            "type": "string"
          },
          "printer_name": {
            "type": "string"
          },
          "job_name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },

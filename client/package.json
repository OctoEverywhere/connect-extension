{
  "name": "octoeverywhere-client",
  "version": "0.1.1",
  "description": "Typed client for the OctoEverywhere Gadget monitoring extension for Prusa Connect Local.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:types": "openapi-typescript openapi.json -o src/generated/module-api.ts"
  },
  "peerDependencies": {
    "@prusa/connect": "0.1.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.3.0",
  "private": true,
  "dependencies": {
    "@prusa/connect": "0.1.0"
  }
}
